# Telegram bot token from @BotFather. DO NOT commit real values here — copy
# this file to .env and edit there. .env is git-ignored.
BOT_TOKEN=REPLACE_WITH_YOUR_BOT_TOKEN

# Provider token for Telegram Stars - leave empty string for XTR currency (Stars handled natively)
STARS_PROVIDER_TOKEN=

# Database (use sqlite+aiosqlite for local dev, postgresql+asyncpg for prod)
DATABASE_URL=sqlite+aiosqlite:///./bot.db

# TwelveData API key (free tier: https://twelvedata.com/pricing)
TWELVEDATA_API_KEY=REPLACE_WITH_YOUR_TWELVEDATA_KEY

# Pricing config (in Telegram Stars)
PREMIUM_MONTHLY_STARS=500
PREMIUM_YEARLY_STARS=4000

# Owner Telegram ID - receives ops alerts
OWNER_TG_ID=

# Health server
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080

# Log level
LOG_LEVEL=INFO
